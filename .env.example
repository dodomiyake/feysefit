# SQLite database (legacy local API — optional)
DATABASE_URL="file:./dev.db"

# JWT signing secret (legacy local API — optional)
AUTH_SECRET="change-me-in-production"

# ---------------------------------------------------------------------------
# Backend selection — enable exactly one mode
# ---------------------------------------------------------------------------
# Supabase is the production backend.
NEXT_PUBLIC_USE_SUPABASE=true
NEXT_PUBLIC_USE_API=false
# Demo mode is for local development only and is rejected in production.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app URL used in invitation emails (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Invitation email delivery (Resend — https://resend.com)
RESEND_API_KEY=
# Local/testing: use Resend sandbox (only delivers to emails you add in Resend dashboard)
INVITE_EMAIL_FROM="FeyseFit <onboarding@resend.dev>"
# Production (after verifying feysefit.com at https://resend.com/domains):
# INVITE_EMAIL_FROM="FeyseFit <invites@feysefit.com>"

# ---------------------------------------------------------------------------
# Auth abuse protection (Cloudflare Turnstile + security event hashing)
# ---------------------------------------------------------------------------
# Create a Turnstile widget at https://dash.cloudflare.com → Turnstile
# Also enable CAPTCHA in Supabase Dashboard → Authentication → Attack Protection
# and paste the same Turnstile secret there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional salt for hashing emails in security_events (defaults to "feysefit")
SECURITY_EVENT_SALT=