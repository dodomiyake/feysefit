# SQLite database (legacy local API — optional)
DATABASE_URL="file:./dev.db"

# JWT signing secret (legacy local API — optional)
AUTH_SECRET="change-me-in-production"

# ---------------------------------------------------------------------------
# Supabase (recommended for web + future Expo MVP)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Legacy Prisma API mode (disabled when Supabase is enabled)
NEXT_PUBLIC_USE_API=false

# Public app URL used in invitation emails (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never put these in NEXT_PUBLIC_*. Missing values fail closed (503 / denied cookies).
SECURITY_COOKIE_SECRET=
SECURITY_COOKIE_SECRET_PREVIOUS=
RATE_LIMIT_HMAC_SECRET=
RATE_LIMIT_HMAC_SECRET_PREVIOUS=
SECURITY_EVENT_HMAC_SECRET=
SECURITY_EVENT_HMAC_SECRET_PREVIOUS=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Prisma API. Production must leave this unset/false. NEXT_PUBLIC_USE_API does not enable routes.
USE_LEGACY_API=false

# Set to 1 only behind a proxy that overwrites forwarding headers (Vercel sets VERCEL=1).
# Do not trust the first x-forwarded-for hop from the client.
TRUSTED_PROXY=
# Set to 1 only when the app is behind Cloudflare. Do not trust cf-connecting-ip merely because it is present.
TRUST_CLOUDFLARE=

# Invitation email delivery (Resend — https://resend.com)
RESEND_API_KEY=
# Local/testing: use Resend sandbox (only delivers to emails you add in Resend dashboard)
INVITE_EMAIL_FROM="FeyseFit <onboarding@resend.dev>"
# Production (after verifying feysefit.com at https://resend.com/domains):
# INVITE_EMAIL_FROM="FeyseFit <invites@feysefit.com>"

# ---------------------------------------------------------------------------
# Auth abuse protection (Cloudflare Turnstile + security event hashing)
# ---------------------------------------------------------------------------
# Create a Turnstile widget at https://dash.cloudflare.com → Turnstile
# Also enable CAPTCHA in Supabase Dashboard → Authentication → Attack Protection
# and paste the same Turnstile secret there (not in this file's NEXT_PUBLIC_* values).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only copy for Next.js siteverify on non-GoTrue routes. Never NEXT_PUBLIC_*.
TURNSTILE_SECRET_KEY=
# Optional. Authorizes POST /auth/uploads/cleanup-quarantine (Storage API byte delete).
CRON_SECRET=